{
  "manifest_version": 3,
  "name": "romledger",
  "version": "0.6.0",
  "key": "",
  "description": "Shows on Vimm's Lair which games your romledger library has or is missing.",
  "permissions": ["storage", "nativeMessaging"],
  "optional_permissions": ["downloads"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/romledger.js", "sites/vimm.js", "background.js"]
  },
  "action": {
    "default_title": "romledger",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://vimm.net/vault/*"],
      "js": [
        "lib/romledger.js",
        "sites/vimm.js",
        "content/page.js",
        "content/queue.js",
        "content/annotate.js"
      ],
      "css": ["romledger.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "romledger@romledger.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
